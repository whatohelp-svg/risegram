+package domain
+
+import "testing"
+
+func TestRiseGramResaleBoundaries(t *testing.T) {
+	for amount, want := range map[int64]bool{124: false, 125: true, 1000000: true, 1000001: false} {
+		price := StarGiftAmount{Currency: StarGiftCurrencyStars, Amount: amount}
+		if got := price.WithinResaleRange(); got != want {
+			t.Fatalf("price %d accepted=%v, want %v", amount, got, want)
+		}
+	}
+}
