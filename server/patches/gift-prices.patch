+-- Keep the identity, attributes, supply and issued serials of existing gifts.
+ALTER TABLE star_gift_collectible_revisions DISABLE TRIGGER star_gift_collectible_revision_guard;
+WITH changed AS (
+    UPDATE star_gift_collectible_revisions r SET upgrade_stars=25
+    FROM star_gift_catalog c
+    WHERE r.id=c.collectible_revision_id AND r.upgrade_stars<>25
+    RETURNING r.id
+)
+UPDATE star_gift_catalog SET updated_at=now() WHERE collectible_revision_id IN (SELECT id FROM changed);
+ALTER TABLE star_gift_collectible_revisions ENABLE TRIGGER star_gift_collectible_revision_guard;
+UPDATE peer_star_gifts SET can_resell_at=0 WHERE can_resell_at>extract(epoch from now());
+UPDATE message_boxes SET media=jsonb_set(media, '{service_action,star_gift,upgrade_price_stars}', '25')
+WHERE (media #>> '{service_action,star_gift,upgrade_price_stars}')::bigint > 0 AND (media #>> '{service_action,star_gift,upgrade_price_stars}')::bigint <> 25;
+UPDATE channel_messages SET action=jsonb_set(action, '{StarGift,upgrade_price_stars}', '25')
+WHERE (action #>> '{StarGift,upgrade_price_stars}')::bigint > 0 AND (action #>> '{StarGift,upgrade_price_stars}')::bigint <> 25;
