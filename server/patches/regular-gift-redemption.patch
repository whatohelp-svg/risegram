+++ b/deploy/migrations/20261121020000_regular_gift_redemption.up.sql
@@ -0,0 +1,23 @@
+WITH updated AS (
+    UPDATE star_gift_catalog_revisions r
+    SET convert_stars = stars/100*85+(stars%100*85+50)/100
+    FROM star_gift_catalog c WHERE r.id=c.active_revision_id
+    AND convert_stars <> stars/100*85+(stars%100*85+50)/100
+    RETURNING r.gift_id
+)
+UPDATE star_gift_catalog SET updated_at=now() WHERE gift_id IN (SELECT gift_id FROM updated);
+
+-- Reprice only outstanding, purchased regular gifts. The price at purchase is
+-- taken from the immutable receipt revision and excludes a prepaid upgrade.
+UPDATE peer_star_gifts g
+SET convert_stars = r.stars/100*85+(r.stars%100*85+50)/100
+FROM star_gift_catalog_revisions r, star_gift_purchase_commands p, users sender
+WHERE g.catalog_revision_id=r.id AND p.saved_gift_id=g.id AND p.charge_stars>=r.stars
+  AND sender.id=p.buyer_user_id AND NOT sender.is_bot AND g.unique_gift_id IS NULL
+  AND NOT g.converted AND g.lifecycle_status='active';
+UPDATE message_boxes b
+SET media=jsonb_set(b.media,'{service_action,star_gift,convert_stars}',to_jsonb(g.convert_stars))
+FROM peer_star_gifts g
+WHERE g.owner_peer_type='user' AND b.owner_user_id=g.owner_peer_id AND b.box_id=g.msg_id
+  AND b.media#>>'{service_action,kind}'='star_gift' AND g.unique_gift_id IS NULL
+  AND g.lifecycle_status='active' AND g.convert_stars>0;
