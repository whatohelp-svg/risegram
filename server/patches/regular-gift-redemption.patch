+package domain
+
+import "testing"
+
+func TestRegularGiftRedemption(t *testing.T) {
+	for price, want := range map[int64]int64{1: 1, 15: 13, 25: 21, 50: 43, 100: 85} {
+		if got := RegularGiftRedemption(price); got != want {
+			t.Errorf("redemption of %d: got %d, want %d", price, got, want)
+		}
+	}
+}
