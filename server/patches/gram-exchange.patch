+	})
+	ledger, configured := s.gifts.(interface {
+		ExchangeGram(context.Context, int64, int64, string) (int64, int64, error)
+	})
+	if !ok || !configured {
+		return 0, 0, fmt.Errorf("wallet unavailable")
+	}
+	if _, err := reader.GetBalance(ctx, user.ID); err != nil {
+		return 0, 0, err
+	}
+	stars, nano, err := ledger.ExchangeGram(ctx, user.ID, delta, key)
+	if err == nil {
+		_ = s.notifyStarsBalanceChanged(ctx, domain.StarsBalance{UserID: user.ID, Balance: stars, Granted: true})
+	}
+	return stars, nano, err
+}
