+func (s *Server) handleClientExchange(w http.ResponseWriter, r *http.Request) {
+	var req struct {
+		Phone string `json:"phone"`
+		Delta int64 `json:"stars_delta"`
+		Key   string `json:"request_id"`
+	}
+	if !decodeJSON(w, r, &req) {
+		return
+	}
+	ledger, ok := s.svc.(interface {
+		ExchangeClientGram(context.Context, string, int64, string) (int64, int64, error)
+	})
+	if !ok {
+		writeError(w, http.StatusServiceUnavailable, "wallet unavailable")
+		return
+	}
+	stars, nano, err := ledger.ExchangeClientGram(r.Context(), req.Phone, req.Delta, req.Key)
+	if errors.Is(err, domain.ErrStarsInsufficient) {
+		writeError(w, http.StatusConflict, "insufficient balance")
+		return
+	}
+	if err != nil {
+		writeError(w, http.StatusBadRequest, "exchange unavailable")
+		return
+	}
+	writeJSON(w, http.StatusOK, map[string]any{"stars": strconv.FormatInt(stars, 10), "gram_nano": strconv.FormatInt(nano, 10)})
+}
