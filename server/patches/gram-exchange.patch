+// ExchangeGram commits both currency movements and their history in one transaction.
+func (s *StarGiftLifecycleStore) ExchangeGram(ctx context.Context, uid, delta int64, key string) (int64, int64, error) {
+	if uid <= 0 || delta == 0 || delta > 900000000000 || delta < -900000000000 || len(key) < 16 || len(key) > 64 {
+		return 0, 0, domain.ErrStarsInvalidAmount
+	}
+	var stars, gram int64
+	date := int(time.Now().Unix())
+	err := withTx(ctx, s.db, "exchange GRAM", func(tx pgx.Tx) error {
+		if _, err := tx.Exec(ctx, `INSERT INTO stars_balances(user_id,balance) VALUES($1,0) ON CONFLICT DO NOTHING`, uid); err != nil {
+			return err
+		}
+		if err := tx.QueryRow(ctx, `SELECT balance FROM stars_balances WHERE user_id=$1 FOR UPDATE`, uid).Scan(&stars); err != nil {
+			return err
+		}
+		var err error
+		gram, err = s.ensureTonGrantTx(ctx, tx, uid, date)
+		if err != nil {
+			return err
+		}
+		var previous int64
+		err = tx.QueryRow(ctx, `SELECT amount FROM stars_transactions WHERE user_id=$1 AND reason='gram_exchange' AND description=$2 LIMIT 1`, uid, key).Scan(&previous)
+		if err == nil {
+			if previous != delta {
+				return domain.ErrStarsInvalidAmount
+			}
+			return nil
+		}
+		if !errors.Is(err, pgx.ErrNoRows) {
+			return err
+		}
+		nano := -delta * 10000000 // 1 GRAM = 100 Stars
+		if stars < -delta || gram < -nano {
+			return domain.ErrStarsInsufficient
+		}
+		if err := tx.QueryRow(ctx, `UPDATE stars_balances SET balance=balance+$2,updated_at=now() WHERE user_id=$1 RETURNING balance`, uid, delta).Scan(&stars); err != nil {
+			return err
+		}
+		if err := tx.QueryRow(ctx, `UPDATE ton_balances SET balance_nanoton=balance_nanoton+$2,updated_at=now() WHERE user_id=$1 RETURNING balance_nanoton`, uid, nano).Scan(&gram); err != nil {
+			return err
+		}
+		if err := insertStarsTxn(ctx, tx, uid, delta, "gram_exchange", domain.Peer{}, date, "Обмен GRAM", key); err != nil {
+			return err
+		}
+		_, err = tx.Exec(ctx, `INSERT INTO ton_transactions(user_id,amount_nanoton,reason,date) VALUES($1,$2,'gram_exchange',$3)`, uid, nano, date)
+		return err
+	})
+	return stars, gram, err
+}
