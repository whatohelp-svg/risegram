+// ClientBalances reads the same personal ledgers as payments.getStarsStatus.
+func (s *Service) ClientBalances(ctx context.Context, phone string) (int64, int64, bool, error) {
+	user, found, err := s.ResolveUserByPhone(ctx, phone)
+	if err != nil || !found {
+		return 0, 0, false, err
+	}
+	stars, ok := s.stars.(interface {
+		GetBalance(context.Context, int64) (domain.StarsBalance, error)
+	})
+	grams, gramOK := s.gifts.(interface {
+		TonBalance(context.Context, int64) (int64, error)
+	})
+	if !ok || !gramOK {
+		return 0, 0, false, fmt.Errorf("wallet service unavailable")
+	}
+	balance, err := stars.GetBalance(ctx, user.ID)
+	if err != nil {
+		return 0, 0, false, err
+	}
+	nano, err := grams.TonBalance(ctx, user.ID)
+	return balance.Balance, nano, true, err
+}
