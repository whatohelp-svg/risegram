+func (s *Server) handleClientBalances(w http.ResponseWriter, r *http.Request) {
+	var req admin.ResolveUserByPhoneRequest
+	if !decodeJSON(w, r, &req) {
+		return
+	}
+	wallet, ok := s.svc.(interface {
+		ClientBalances(context.Context, string) (int64, int64, bool, error)
+	})
+	if !ok {
+		writeError(w, http.StatusNotImplemented, "wallet unavailable")
+		return
+	}
+	stars, nano, found, err := wallet.ClientBalances(r.Context(), req.Phone)
+	if err != nil {
+		writeError(w, http.StatusServiceUnavailable, "wallet unavailable")
+		return
+	}
+	w.Header().Set("Cache-Control", "no-store")
+	writeJSON(w, http.StatusOK, map[string]any{"found": found, "stars": strconv.FormatInt(stars, 10), "gram_nano": strconv.FormatInt(nano, 10)})
+}
+
+func (s *Server) handleResolveChannelUsername(w http.ResponseWriter, r *http.Request) {
+	resolver, ok := s.svc.(interface {
+		ResolvePublicChannelForAdmin(context.Context, string) (domain.Channel, bool, error)
+	})
+	if !ok {
+		writeError(w, http.StatusNotImplemented, "channel lookup unavailable")
+		return
+	}
+	channel, found, err := resolver.ResolvePublicChannelForAdmin(r.Context(), r.URL.Query().Get("username"))
+	if err != nil {
+		writeError(w, http.StatusBadRequest, "channel lookup failed")
+		return
+	}
+	writeJSON(w, http.StatusOK, map[string]any{"found": found, "channel_id": strconv.FormatInt(channel.ID, 10)})
+}
