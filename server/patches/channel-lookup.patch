+func (s *Server) handleResolveChannelUsername(w http.ResponseWriter, r *http.Request) {
+	resolver, ok := s.svc.(interface {
+		ResolvePublicChannelForAdmin(context.Context, string) (domain.Channel, bool, error)
+	})
+	if !ok {
+		writeError(w, http.StatusNotImplemented, "channel lookup unavailable")
+		return
+	}
+	channel, found, err := resolver.ResolvePublicChannelForAdmin(r.Context(), r.URL.Query().Get("username"))
+	if err != nil {
+		writeError(w, http.StatusBadRequest, "channel lookup failed")
+		return
+	}
