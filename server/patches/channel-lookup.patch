+func (s *Service) ResolvePublicChannelForAdmin(ctx context.Context, username string) (domain.Channel, bool, error) {
+	username = domain.NormalizeUsername(username)
+	if !domain.ValidCollectibleUsername(username) {
+		return domain.Channel{}, false, domain.ErrUsernameInvalid
+	}
+	return s.channels.ResolvePublicChannelUsername(ctx, 0, username)
+}
