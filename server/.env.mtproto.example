# Copy to .env.mtproto and replace all CHANGE_ME secrets.
# Do not commit a filled .env.mtproto file.
# This file is for an isolated LOCAL development stack. Do not expose the static
# development login code to the public internet.
TELESRV_LISTEN=0.0.0.0:2398
TELESRV_ADVERTISE_IP=127.0.0.1
TELESRV_DC=2
TELESRV_PUBLIC_BASE_URL=http://127.0.0.1:2401
TELESRV_PUBLIC_WEB_BASE_URL=http://127.0.0.1:2401
TELESRV_RSA_KEY=/var/lib/telesrv/server_rsa.pem
TELESRV_IDENTITY_DIR=/var/lib/telesrv/identity
TELESRV_BLOB_BACKEND=localfs
TELESRV_BLOB_DIR=/var/lib/telesrv/blobs
TELESRV_BLOB_STAGING_DIR=/var/lib/telesrv/blob-staging
TELESRV_POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
TELESRV_POSTGRES_DSN=postgres://telesrv:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/telesrv_main?sslmode=disable
TELESRV_REDIS_ADDR=redis:6379
TELESRV_REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
TELESRV_REDIS_DB=0
TELESRV_ADMIN_API_TOKEN=CHANGE_ME_LONG_RANDOM_ADMIN_API_TOKEN
TELESRV_ADMIN_API_ADDR=0.0.0.0:2599
TELESRV_ADMIN_UI_ADDR=0.0.0.0:2600
TELESRV_ADMIN_UI_PASSWORD=CHANGE_ME_ADMIN_UI_PASSWORD
TELESRV_ADMIN_SESSION_KEY=CHANGE_ME_LONG_RANDOM_SESSION_KEY
TELESRV_TURN_SECRET=CHANGE_ME_LONG_RANDOM_TURN_SECRET
TELESRV_PHONE_CODE_DELIVERY_PROVIDER=development
TELESRV_DEV_AUTH_CODE=12345
