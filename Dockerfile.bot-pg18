# RiseGram bot runtime with PostgreSQL 18 client for consistent offline backups.
# This is a Python bot container — it MUST NOT run a PostgreSQL server.
FROM postgres:18-trixie
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    VIRTUAL_ENV=/opt/risegram-venv
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-venv ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements.txt /app/requirements.txt
RUN python3 -m venv /opt/risegram-venv \
    && /opt/risegram-venv/bin/pip install --no-cache-dir -r /app/requirements.txt
COPY . /app/
ENV PATH="/opt/risegram-venv/bin:/usr/lib/postgresql/18/bin:${PATH}"
STOPSIGNAL SIGTERM
ENTRYPOINT ["/opt/risegram-venv/bin/python"]
CMD ["/app/run.py"]
